# Путь к репозиторию с ETL (new_admin_panel_sprint_3) относительно этого проекта
ETL_PROJECT_PATH=../new_admin_panel_sprint_3

POSTGRES_DB=movies_database
POSTGRES_USER=app
POSTGRES_PASSWORD=123qwe

PROJECT_NAME=movies
LOG_LEVEL=INFO
CACHE_EXPIRE_IN_SECONDS=300
API_WORKERS=2
NGINX_PORT=80

ES_JAVA_OPTS=-Xms512m -Xmx512m
REDIS_MAXMEMORY=256mb

# Сервис авторизации. Секреты обязательны; ключ подписи JWT — не короче
# 32 символов, сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_POSTGRES_DB=auth
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=change-me-auth-db-password
AUTH_JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
AUTH_LOG_LEVEL=INFO
AUTH_WORKERS=2

# Вход через соцсети. Поставщик включается, только когда заданы обе его
# переменные, — иначе его эндпоинты отвечают 404, а остальной вход работает
# как прежде. Ключи выдаёт сам поставщик при регистрации приложения:
#   Яндекс — https://oauth.yandex.ru/client/new
#   Google — https://console.cloud.google.com/apis/credentials
# В настройках приложения у поставщика укажите адрес возврата:
#   http://localhost/auth/api/v1/oauth/yandex/callback
#   http://localhost/auth/api/v1/oauth/google/callback
AUTH_OAUTH_YANDEX_CLIENT_ID=
AUTH_OAUTH_YANDEX_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_REDIRECT_BASE_URL=http://localhost

# Распределённая трассировка. Спаны уходят в Jaeger, его интерфейс —
# http://localhost:16686. Пустое значение выключает трассировку.
OTLP_ENDPOINT=http://jaeger:4318/v1/traces
JAEGER_UI_PORT=16686

# Админка каталога. Ключ подписи сессий обязателен и не короче 32 символов,
# сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Пароли сотрудников хранит сервис авторизации, здесь их нет.
DJANGO_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_LOG_LEVEL=INFO
ADMIN_WORKERS=2

# Сервис сбора пользовательских действий и брокер событий. Ключ подписи
# токенов сервис берёт из AUTH_JWT_SECRET_KEY выше: он проверяет подпись тем
# же секретом, которым её поставил сервис авторизации.
UGC_KAFKA_TOPIC=ugc.events
# Партиций столько, сколько потребителей может работать одновременно; меньше
# 12 ставить не стоит — поток событий пойдёт через одного потребителя.
UGC_KAFKA_PARTITIONS=12
UGC_MAX_EVENTS_PER_REQUEST=200
UGC_LOG_LEVEL=INFO
UGC_WORKERS=2
# Идентификатор кластера Kafka. Генерируется один раз на кластер:
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
# Менять его у поднятого кластера нельзя — он записан в данных брокера.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Сервис пользовательского контента: лайки, рецензии и закладки. Ключ подписи
# токенов он тоже берёт из AUTH_JWT_SECRET_KEY: токены выпускает Auth.
CONTENT_MONGO_DATABASE=ugc_content
CONTENT_PAGE_SIZE_DEFAULT=20
# Предел страницы: длинная страница ломает бюджет ответа в 200 мс.
CONTENT_PAGE_SIZE_MAX=100
CONTENT_LOG_LEVEL=INFO
CONTENT_WORKERS=2
# Куда сервисы шлют неотловленные исключения. Пустое значение выключает
# отправку: локальный стек поднимается без Sentry. Свой DSN берётся в
# интерфейсе Sentry: Settings → Client keys (DSN).
CONTENT_SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Приёмник ошибок на стенде — GlitchTip (профиль glitchtip в
# deploy/observability/docker-compose.yml). Его DSN подставляется в SENTRY_DSN
# выше; он совместим с sentry-sdk, поэтому код сервисов не меняется.
GLITCHTIP_PORT=9001
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=glitchtip

# Секретный ключ для профиля sentry (старый образ Sentry 9, см. README
# наблюдаемости: на современном окружении он не доводит обработку до конца).
SENTRY_SECRET_KEY=

# ETL событий и аналитическое хранилище.
CLICKHOUSE_DB=ugc
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Пачка вставки в ClickHouse: вставлять по строке нельзя — каждая вставка
# создаёт на диске новый кусок, и хранилище захлебнётся слияниями.
UGC_ETL_BATCH_SIZE=10000
UGC_ETL_POLL_TIMEOUT=5
# Сколько ETL копит события, прежде чем вставить неполную пачку, секунд.
# Меньше — чаще мелкие вставки и больше кусков в MergeTree; больше — выше
# задержка доставки события в хранилище (предел по требованиям — 5 минут).
UGC_ETL_BATCH_MAX_WAIT=30
# При каком потреблении памяти ETL считать, что приложение потекло, МБ.
UGC_ETL_MEMORY_LIMIT_MB=512
UGC_ETL_LOG_LEVEL=INFO
